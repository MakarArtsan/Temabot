# ---------- Telegram ----------
TG_API_ID=
TG_API_HASH=
TG_SESSION=./data/collector.session
TG_SESSION_STRING=            # StringSession, генерится локально (шаг 13); на Amvera файл .session не нужен
TG_GROUP_ID=-100...           # только для первого запуска; дальше группы включаются в админке
# collector при первом старте сам заливает историю за столько дней (0 — не заливать)
BACKFILL_DAYS=7
BOT_TOKEN=                    # токен существующего бота-копировщика (перевыпущенный)
BOT_API_URL=                  # пусто — api.telegram.org; для проверок — подставной Bot API
OWNER_ID=
TELEGRAPH_TOKEN=              # пусто при первом запуске — бот напишет токен в лог
TELEGRAPH_SHORT_NAME=TeleTemaBot
BOT_USERNAME=              # имя бота без @, нужно виджету входа в админку
# telegraph — ссылка на страницу (её откроет любой, у кого она есть);
# dm — текст приходит в личку запросившему, наружу ничего не уходит
COPY_MODE=telegraph

# ---------- LLM (OpenAI-совместимый) ----------
# DeepSeek: base_url без /v1, актуальный id модели — deepseek-flash
# (старые deepseek-chat / deepseek-v4-flash ещё принимаются, но объявлены устаревшими).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# deepseek-flash и GLM — reasoning-модели. disabled убирает размышления совсем:
# замерено — 39 токенов на ответ вместо 382, и JSON остаётся корректным.
# auto — вернуть размышления (дороже, иногда точнее на сложных задачах).
LLM_THINKING=disabled
# Для провайдеров, где thinking не отключается (GLM): low|medium|high, иначе пусто.
LLM_REASONING_EFFORT=
# Цена за миллион токенов в долларах — только для оценки расходов в админке
LLM_PRICE_IN=0.30
LLM_PRICE_OUT=1.20

# ---------- Эмбеддинги ----------
EMBED_BACKEND=local          # local|api
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# У DeepSeek эндпоинта эмбеддингов нет (404), поэтому при EMBED_BACKEND=api
# нужен отдельный провайдер. Пусто — берутся LLM_BASE_URL и LLM_API_KEY.
EMBED_BASE_URL=
EMBED_API_KEY=

# ---------- БД ----------
# Supabase: бери строку из Connect. Прямое подключение (db.xxx.supabase.co)
# работает только по IPv6 — для облаков обычно нужен Session pooler.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_POOL_SIZE=10
DB_DISABLE_STATEMENT_CACHE=false   # true, если подключаешься через пулер на 6543

# ---------- ASR (расшифровка голосовых) ----------
ASR_ENABLED=true             # false — не расшифровывать (экономия памяти на слабом тарифе)
# auto — сначала силами Telegram (нужен Premium у аккаунта коллектора),
# иначе локальный whisper. Варианты: auto | telegram | local
ASR_PROVIDER=auto
TELEGRAM_ASR_MAX_SEC=180     # записи длиннее Telegram не расшифровывает
TELEGRAM_ASR_WAIT_SEC=90     # сколько ждать готовую расшифровку
WHISPER_MODEL=small          # tiny|base|small|medium — больше модель, выше качество и память
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru          # пусто — автоопределение языка
WHISPER_BEAM_SIZE=5          # 1 — вдвое быстрее, качество чуть ниже
WHISPER_CPU_THREADS=0        # 0 — по числу ядер
MEDIA_CONCURRENCY=2          # сколько голосовых расшифровывать одновременно
MEDIA_KEEP_FILES=true        # false — удалять аудиофайл после расшифровки
VISION_ENABLED=false         # true — описывать картинки мультимодальной моделью

# ---------- Сеть ----------
PROXY_URL=                   # socks5://user:pass@host:port, опционально
TZ=Europe/Moscow
LOG_LEVEL=INFO
APP_ROLE=all                 # all — всё в одном контейнере; или collector|bot|web
SERVICES=bot,web,collector   # что запускать при APP_ROLE=all

# ---------- Веб-админка ----------
WEB_SECRET_KEY=              # для сессионных кук
WEB_BASE_URL=https://<проект>.amvera.io
WEB_HOST=0.0.0.0
WEB_PORT=8080                 # локально; на Amvera не задавать — там порт 80 из Dockerfile
