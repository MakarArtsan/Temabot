# ---------- Telegram ----------
TG_API_ID=
TG_API_HASH=
TG_SESSION=./data/collector.session
TG_SESSION_STRING=            # StringSession, генерится локально (шаг 13); на Amvera файл .session не нужен
TG_GROUP_ID=-100...           # только для первого запуска; дальше группы включаются в админке
BOT_TOKEN=                    # токен существующего бота-копировщика (перевыпущенный)
OWNER_ID=
TELEGRAPH_TOKEN=              # пусто при первом запуске — бот напишет токен в лог
TELEGRAPH_SHORT_NAME=TeleTemaBot

# ---------- LLM (OpenAI-совместимый) ----------
# DeepSeek: base_url без /v1, актуальный id модели — deepseek-flash
# (старые deepseek-chat / deepseek-v4-flash ещё принимаются, но объявлены устаревшими).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Только для GLM: у него reasoning не отключается, и без low улетают тысячи токенов.
# Для DeepSeek оставить пустым.
LLM_REASONING_EFFORT=

# ---------- Эмбеддинги ----------
EMBED_BACKEND=local          # local|api
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ---------- БД ----------
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---------- ASR (расшифровка голосовых) ----------
ASR_ENABLED=true             # false — не расшифровывать (экономия памяти на слабом тарифе)
WHISPER_MODEL=small          # tiny|base|small|medium — больше модель, выше качество и память
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru          # пусто — автоопределение языка
WHISPER_BEAM_SIZE=5          # 1 — вдвое быстрее, качество чуть ниже
WHISPER_CPU_THREADS=0        # 0 — по числу ядер
MEDIA_CONCURRENCY=2          # сколько голосовых расшифровывать одновременно
MEDIA_KEEP_FILES=true        # false — удалять аудиофайл после расшифровки

# ---------- Сеть ----------
PROXY_URL=                   # socks5://user:pass@host:port, опционально
TZ=Asia/Kamchatka
LOG_LEVEL=INFO
APP_ROLE=bot                 # collector|bot|web

# ---------- Веб-админка ----------
WEB_SECRET_KEY=              # для сессионных кук
WEB_BASE_URL=https://<проект>.amvera.io
WEB_HOST=0.0.0.0
WEB_PORT=8080
